{
  "manifest_version": 3,
  "name": "DevKit – Developer Tools",
  "short_name": "DevKit",
  "version": "1.1.0",
  "description": "23 offline developer tools: JSON, JWT, diff, JSON to TypeScript, cURL to fetch, webhook signatures and more. Nothing leaves your browser.",
  "homepage_url": "https://devkit-ng.vercel.app",
  "permissions": ["contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open DevKit (Alt+Shift+D)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Open DevKit" }
  }
}
